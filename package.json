  "devDependencies": {
    "chai": "^5.3.3",
    "chai-http": "^4.4.0",
    "diff": "8.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "mocha": "^11.7.6",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "sequelize-cli": "^6.6.5",
    "serialize-javascript": "7.0.5"
